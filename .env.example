# Langfuse instance URL (no trailing slash)
LANGFUSE_HOST=https://langfuse.example.com

# Langfuse API credentials — create in Project Settings > API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# MCP transport: stdio (local Claude Code) or streamable-http (gateway / remote)
MCP_TRANSPORT=streamable-http

# Bind address + port for HTTP transports (no-op for stdio)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional: default output mode exposed in tool schemas (compact|full|full_json_file)
LANGFUSE_MCP_DEFAULT_OUTPUT_MODE=compact
